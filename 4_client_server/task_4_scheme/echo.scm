(use-modules (ice-9 rdelim) (ice-9 threads))

(define log-file "server.log")
(define log-mutex (make-mutex))

(define (now)
  (strftime "%Y-%m-%d %H:%M:%S" (localtime (current-time))))

(define (log-request client command reply)
  (let ((entry (string-append (now) " | " client " | " command " | " reply)))
    (with-mutex log-mutex
      (let ((port (open-file log-file "a")))
        (display entry port)
        (newline port)
        (close-port port))
      (display (string-append "[log] " entry))
      (newline))))

(define (split-command line)
  (let ((space (string-index line #\space)))
    (if space
        (cons (string-upcase (substring line 0 space))
              (string-trim-both (substring line (+ space 1))))
        (cons (string-upcase line) ""))))

(define (handle command argument)
  (cond ((string=? command "ECHO") argument)
        ((string=? command "UPPER") (string-upcase argument))
        ((string=? command "TIME") (now))
        ((string=? command "QUIT") "BYE")
        (else (string-append "ERROR unknown command '" command "' (ECHO text | UPPER text | TIME | QUIT)"))))

(define (send-line sock text)
  (display text sock)
  (newline sock)
  (force-output sock))

(define (serve-client sock addr)
  (let ((client (string-append (inet-ntop AF_INET (sockaddr:addr addr))
                               ":" (number->string (sockaddr:port addr)))))
    (display (string-append "Client connected: " client))
    (newline)
    (let loop ()
      (let ((line (read-line sock)))
        (if (eof-object? line)
            (begin (display (string-append "Client disconnected: " client)) (newline))
            (let* ((text (string-trim-both line))
                   (parts (split-command text))
                   (reply (handle (car parts) (cdr parts))))
              (send-line sock reply)
              (log-request client text reply)
              (if (string=? (car parts) "QUIT")
                  (begin (display (string-append "Client quit: " client)) (newline))
                  (loop))))))
    (close-port sock)))

(define (run-server port)
  (let ((server (socket PF_INET SOCK_STREAM 0)))
    (setvbuf (current-output-port) 'line)
    (setsockopt server SOL_SOCKET SO_REUSEADDR 1)
    (bind server AF_INET INADDR_ANY port)
    (listen server 5)
    (display (string-append "Echo server on port " (number->string port) ", log: " log-file))
    (newline)
    (let loop ()
      (let* ((conn (accept server))
             (sock (car conn))
             (addr (cdr conn)))
        (call-with-new-thread (lambda () (serve-client sock addr)))
        (loop)))))

(define (run-client host port)
  (let ((sock (socket PF_INET SOCK_STREAM 0)))
    (connect sock AF_INET (inet-pton AF_INET host) port)
    (display "Connected. Commands: ECHO text | UPPER text | TIME | QUIT")
    (newline)
    (let loop ()
      (display "> ")
      (force-output)
      (let ((line (read-line)))
        (unless (eof-object? line)
          (send-line sock line)
          (let ((reply (read-line sock)))
            (unless (eof-object? reply)
              (display (string-append "< " reply))
              (newline)
              (unless (string=? reply "BYE") (loop)))))))
    (newline)
    (close-port sock)))

(define (main args)
  (cond ((and (pair? args) (string=? (car args) "server"))
         (run-server (if (pair? (cdr args)) (string->number (cadr args)) 8080)))
        ((and (pair? args) (string=? (car args) "client"))
         (run-client (if (pair? (cdr args)) (cadr args) "127.0.0.1")
                     (if (and (pair? (cdr args)) (pair? (cddr args))) (string->number (caddr args)) 8080)))
        (else (display "Usage: guile echo.scm server [port] | guile echo.scm client [host] [port]")
              (newline))))

(main (cdr (command-line)))
